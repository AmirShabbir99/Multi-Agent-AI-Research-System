# ===========================================================
# Root environment file - used ONLY by docker-compose.yml to
# fan secrets out to the three services' containers.
#
# For running services individually without Docker, use each
# service's own .env instead (ai-service/.env, server/.env,
# client/.env) copied from their respective .env.example files.
#
# Copy this file to `.env` at the repo root before running:
#   docker compose up --build
# ===========================================================

# Shared secret between the Node server and the FastAPI AI service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change_this_to_a_long_random_secret

# JWT secret (single stateless token - no refresh token)
JWT_SECRET=change_this_too

# LLM provider for the AI service (mistral | openai | anthropic)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=mistral

# Web search tool used by the research agents
TAVILY_API_KEY=your_tavily_api_key_here

# Vector store backend (faiss | mongodb)
VECTOR_DB_PROVIDER=faiss

# Public URL of the deployed client (used in the server's CORS allow-list)
CLIENT_URL=http://localhost:8080

# Optional: auto-create an admin account on first server boot
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
