# ===========================================================
# AI Service (FastAPI) - environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file - it is already git-ignored.
# ===========================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Security ─────────────────────────────────────────────────
# Shared secret with the Node.js server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match INTERNAL_AI_SERVICE_API_KEY in server/.env exactly.
INTERNAL_API_KEY=change_this_to_a_long_random_secret

# Comma-separated. In production this should just be the Node server's origin.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# ── LLM provider (mistral | openai | anthropic) ────────────────
LLM_PROVIDER=mistral
LLM_TEMPERATURE=0.2

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_CHAT_MODEL=mistral-small-latest

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# ── Embeddings (mistral | openai) ───────────────────────────────
EMBEDDING_PROVIDER=mistral
MISTRAL_EMBED_MODEL=mistral-embed
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# ── Web search / scraping ───────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
SCRAPE_TIMEOUT_SECONDS=8
SCRAPE_MAX_CHARS=4000

# ── Vector store (faiss | mongodb) ──────────────────────────────
VECTOR_DB_PROVIDER=faiss
VECTOR_STORE_DIR=app/../data/vector_store

# Only needed when VECTOR_DB_PROVIDER=mongodb (requires MongoDB Atlas +
# a pre-created $vectorSearch index - see ai-service/README section on this)
MONGODB_URI=
MONGODB_DB_NAME=ai_service
MONGODB_VECTOR_COLLECTION=document_chunks
MONGODB_VECTOR_INDEX_NAME=vector_index

# ── Document processing ─────────────────────────────────────────
DOCUMENTS_DIR=app/../data/documents
REGISTRY_DB_PATH=app/../data/registry.sqlite3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md

# ── Retrieval ────────────────────────────────────────────────────
DEFAULT_TOP_K=5
MAX_TOP_K=20

# ── Session buffer ───────────────────────────────────────────────
SESSION_DB_PATH=app/../data/sessions.sqlite3
MAX_HISTORY_TURNS_IN_PROMPT=12

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
