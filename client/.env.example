# ===========================================================
# React Client - environment configuration
# Copy this file to `.env` for local development.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ===========================================================

# Base path the axios instance calls. Left as /api by default so the Vite
# dev-server proxy (see vite.config.js) forwards it to the Node server -
# no CORS setup needed for local dev.
VITE_API_BASE_URL=/api

# Used by vite.config.js's dev-server proxy target (server-side only, not exposed to the browser).
VITE_API_PROXY_TARGET=http://localhost:5000
