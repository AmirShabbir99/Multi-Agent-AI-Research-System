# ===========================================================
# Node.js Server - environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file - it is already git-ignored.
# ===========================================================

NODE_ENV=development
PORT=5000

# The React client's origin (for CORS)
CLIENT_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/researchmind

# ── JWT (single stateless token - no refresh token) ─────────
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI Service (FastAPI) ─────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Must match INTERNAL_API_KEY in ai-service/.env exactly.
INTERNAL_AI_SERVICE_API_KEY=change_this_to_a_long_random_secret
AI_SERVICE_TIMEOUT_MS=60000

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md

# ── Security ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
TRUST_PROXY=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Admin seed script (npm run seed:admin) ──────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
